# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  pkgs,
  config,
  lib,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];
  boot = {
    initrd = {
      availableKernelModules = ["nvme" "xhci_pci" "thunderbolt" "usb_storage" "sd_mod"];
      kernelModules = ["dm-snapshot"];

      luks.devices = {
        root = {
          # Use https://nixos.wiki/wiki/Full_Disk_Encryption
          device = "/dev/disk/by-uuid/8d260438-dcbf-414e-9f49-03b9c86cc8b9";
          preLVM = true;
        };
      };
    };
    kernelModules = ["kvm-amd" "amdgpu"];
    extraModulePackages = [];
    kernelParams = [
      "systemd.gpt_auto=0" # Solve annoying dmesg warning
      "amdgpu.dcdebugmask=0x10" # Fix GPU flickering and lag (P14s Gen 5)
    ];
    kernel.sysctl = {
      "kernel.sysrq" = 502;
      "vm.overcommit_memory" = 1;
    };
    kernelPackages = pkgs.linuxPackages;

    # Enable thinkpad_acpi fan control for thinkfan and battery thresholds
    extraModprobeConfig = ''
      options thinkpad_acpi fan_control=1 charge_start_thresh=75 charge_stop_thresh=85
    '';
  };

  services.thinkfan = {
    # Using direct paths due to thinkfan 2.0.0 issues with name-based lookup
    # TODO: Switch to name-based when thinkfan fixes sensor discovery
    # Reference: https://github.com/kikislater/thinkpad-p14s-g5-linux/blob/master/thinkfan.conf
    enable = true;
    sensors = [
      # GPU (amdgpu - hwmon10)
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon10/temp1_input";
      }

      # CPU (k10temp - hwmon1)
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon1/temp1_input";
      }

      # ThinkPad EC sensors (hwmon9)
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon9/temp1_input";
      }
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon9/temp3_input";
      }
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon9/temp6_input";
      }
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon9/temp7_input";
      }

      # SSD (nvme - hwmon0) - temperature readings with -5°C correction
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon0/temp1_input";
        correction = [(-5)];
      }

      # Motherboard (acpitz - hwmon4)
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon4/temp1_input";
      }
    ];
    fans = [
      {
        type = "tpacpi";
        query = "/proc/acpi/ibm/fan";
      }
    ];
    # Aggressive fan curve from reference repo (starts at 60°C, full-speed at 79°C)
    levels = [
      [0 0 60]
      [1 58 63]
      [2 61 66]
      [3 64 69]
      [4 67 72]
      [5 70 75]
      [6 73 78]
      [7 76 81]
      ["level full-speed" 79 32767]
    ];
  };

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/099f8145-315b-4129-9f2e-493675df0e5c";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/C6FF-26EE";
    fsType = "vfat";
    options = ["fmask=0022" "dmask=0022"];
  };

  swapDevices = [
    {device = "/dev/disk/by-uuid/64fa1a26-1ebd-49c9-93ab-8e62a9681395";}
  ];

  fileSystems."/home/${config.username}/Data" = {
    device = "/dev/disk/by-uuid/f5030753-0267-4c2b-8eba-03039bcc9de5";
    fsType = "ext4";
    options = ["nofail"];
  };

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.enp1s0f0.useDHCP = lib.mkDefault true;
  # networking.interfaces.wlp2s0.useDHCP = lib.mkDefault true;

  # GPU Acceleration
  hardware.graphics = {
    enable = true;
    enable32Bit = true;
    extraPackages = with pkgs; [
      stable.rocmPackages.clr.icd
      # VAAPI drivers for AMD GPU
      mesa
      libva-vdpau-driver
      libvdpau-va-gl
    ];
  };

  environment.variables = {
    # VAAPI and VDPAU config for accelerated video.
    # See https://wiki.archlinux.org/index.php/Hardware_video_acceleration
    "VDPAU_DRIVER" = "radeonsi";
    "LIBVA_DRIVER_NAME" = "radeonsi";
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
