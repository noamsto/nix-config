# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  pkgs,
  config,
  lib,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];
  boot = {
    initrd = {
      availableKernelModules = ["nvme" "xhci_pci" "thunderbolt" "usb_storage" "sd_mod"];

      # disko declares the LUKS device as `cryptroot`; this just adds the TPM crypttab option.
      luks.devices.cryptroot.crypttabExtraOpts = ["tpm2-device=auto"];
    };
    kernelModules = ["kvm-amd" "amdgpu"];
    extraModulePackages = [];
    kernelParams = [
      "systemd.gpt_auto=0" # Solve annoying dmesg warning
      "amdgpu.dcdebugmask=0x10" # Fix GPU flickering and lag (P14s Gen 5)
      "acpi.ec_no_wakeup=1" # Prevent spurious wake on AC plug/unplug (see docs/power-management.md)
      "amd_pmc.enable_stb=0" # Allow s2idle to reach deepest sleep state
      "rtc_cmos.use_acpi_alarm=1" # Use ACPI alarm for RTC, avoids s2idle deep sleep blocker on AMD
      "amd_pstate=active" # Ensure amd-pstate EPP driver loads (TLP also sets this at runtime)
    ];
    kernel.sysctl = {
      "vm.overcommit_memory" = 1;
    };
    kernelPackages = pkgs.linuxPackages_latest;

    # Enable thinkpad_acpi fan control for thinkfan and battery thresholds
    extraModprobeConfig = ''
      options thinkpad_acpi fan_control=1
      options ath11k_pci frame_mode=2
    '';
  };

  # fileSystems and swapDevices are managed by disko (./disko.nix).

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.enp1s0f0.useDHCP = lib.mkDefault true;
  # networking.interfaces.wlp2s0.useDHCP = lib.mkDefault true;

  # GPU Acceleration
  hardware = {
    graphics = {
      enable = true;
      enable32Bit = true;
      extraPackages = with pkgs; [
        rocmPackages.clr.icd
        # VAAPI drivers for AMD GPU
        mesa
        libva-vdpau-driver
        libvdpau-va-gl
      ];
    };
    cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
    amdgpu.initrd.enable = true;
  };

  environment.variables = {
    # VAAPI and VDPAU config for accelerated video.
    # See https://wiki.archlinux.org/index.php/Hardware_video_acceleration
    "VDPAU_DRIVER" = "radeonsi";
    "LIBVA_DRIVER_NAME" = "radeonsi";
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
}
