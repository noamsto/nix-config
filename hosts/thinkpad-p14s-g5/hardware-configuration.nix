# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  pkgs,
  config,
  lib,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = ["nvme" "xhci_pci" "thunderbolt" "usb_storage" "sd_mod"];
  boot.initrd.kernelModules = ["dm-snapshot"];
  boot.kernelModules = ["kvm-amd" "amdgpu"];
  boot.extraModulePackages = [];
  boot.kernelParams = [
    "systemd.gpt_auto=0" # Solve annoying dmesg warning
    "amdgpu.dcdebugmask=0x10" # Fix GPU flickering and lag (P14s Gen 5)
  ];
  boot.kernel.sysctl = {
    "kernel.sysrq" = 502;
    "vm.overcommit_memory" = 1;
  };
  boot.kernelPackages = pkgs.linuxPackages_latest;

  # Enable thinkpad_acpi fan control for thinkfan
  boot.extraModprobeConfig = ''
    options thinkpad_acpi fan_control=1
  '';

  services.thinkfan = {
    # Simplified configuration using direct hwmon paths
    enable = true;
    sensors = [
      # GPU (hwmon10)
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon10/temp1_input";
      }

      # CPU (hwmon1 - k10temp)
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon1/temp1_input";
      }

      # ThinkPad EC sensors (hwmon8)
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon8/temp1_input";
      }
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon8/temp3_input";
      }
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon8/temp6_input";
      }
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon8/temp7_input";
      }

      # ACPI thermal zone (hwmon4)
      {
        type = "hwmon";
        query = "/sys/class/hwmon/hwmon4/temp1_input";
      }
    ];
    fans = [
      {
        type = "tpacpi";
        query = "/proc/acpi/ibm/fan";
      }
    ];
    levels = [
      [0 0 55]
      [1 53 58]
      [2 56 61]
      [3 59 64]
      [4 62 67]
      [5 65 70]
      [6 69 74]
      [7 72 77]
      ["level full-speed" 75 32767]
    ];
  };

  boot.initrd.luks.devices = {
    root = {
      # Use https://nixos.wiki/wiki/Full_Disk_Encryption
      device = "/dev/disk/by-uuid/8d260438-dcbf-414e-9f49-03b9c86cc8b9";
      preLVM = true;
    };
  };

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/099f8145-315b-4129-9f2e-493675df0e5c";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/C6FF-26EE";
    fsType = "vfat";
    options = ["fmask=0022" "dmask=0022"];
  };

  swapDevices = [
    {device = "/dev/disk/by-uuid/64fa1a26-1ebd-49c9-93ab-8e62a9681395";}
  ];

  fileSystems."/home/${config.username}/Data" = {
    device = "/dev/disk/by-uuid/f5030753-0267-4c2b-8eba-03039bcc9de5";
    fsType = "ext4";
    options = ["nofail"];
  };

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.enp1s0f0.useDHCP = lib.mkDefault true;
  # networking.interfaces.wlp2s0.useDHCP = lib.mkDefault true;

  # GPU Acceleration
  hardware.graphics = {
    enable = true;
    enable32Bit = true;
    extraPackages = with pkgs; [
      stable.rocmPackages.clr.icd
      # VAAPI drivers for AMD GPU
      mesa
      libva-vdpau-driver
      libvdpau-va-gl
    ];
  };

  environment.variables = {
    # VAAPI and VDPAU config for accelerated video.
    # See https://wiki.archlinux.org/index.php/Hardware_video_acceleration
    "VDPAU_DRIVER" = "radeonsi";
    "LIBVA_DRIVER_NAME" = "radeonsi";
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
