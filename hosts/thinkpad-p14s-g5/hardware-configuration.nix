# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  pkgs,
  config,
  lib,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = ["nvme" "xhci_pci" "thunderbolt" "usb_storage" "sd_mod"];
  boot.initrd.kernelModules = ["dm-snapshot"];
  boot.kernelModules = ["kvm-amd" "amdgpu"];
  boot.extraModulePackages = [];
  boot.kernelParams = [
    "systemd.gpt_auto=0" # Solve annoying dmesg warning
  ];
  boot.kernel.sysctl."kernel.sysrq" = 502;
  boot.kernelPackages = pkgs.linuxPackages_latest;

  services.thinkfan = {
    # Reference: https://github.com/m4tx/thinkpad-p14s-g4-linux/blob/master/thinkfan.conf
    enable = false;
    sensors = [
      # GPU
      {
        name = "amdgpu";
        type = "hwmon";
        indices = [1];
        query = "/sys/class/hwmon";
      }

      # CPU
      {
        name = "k10temp";
        type = "hwmon";
        indices = [1];
        query = "/sys/class/hwmon";
      }
      {
        name = "thinkpad";
        type = "hwmon";
        indices = [1 3 6 7];
        query = "/sys/class/hwmon";
        max_errors = 10;
      }
      # SSD
      {
        name = "nvme";
        type = "hwmon";
        indices = [1 2 3];
        correction = [(-5) 0 0];
        query = "/sys/class/hwmon";
      }
      #   # MB
      {
        name = "acpitz";
        type = "hwmon";
        indices = [1];
        query = "/sys/class/hwmon";
      }
    ];
    fans = [
      {
        type = "tpacpi";
        query = "/proc/acpi/ibm/fan";
      }
    ];
    levels = [
      [0 0 55]
      [1 53 58]
      [2 56 61]
      [3 59 64]
      [4 62 67]
      [5 65 70]
      [6 69 74]
      [7 72 77]
      ["level full-speed" 75 32767]
    ];
  };

  boot.initrd.luks.devices = {
    root = {
      # Use https://nixos.wiki/wiki/Full_Disk_Encryption
      device = "/dev/disk/by-uuid/7aac95c6-87d1-489e-86ca-3747b8c74c7f";
      preLVM = true;
    };
  };

  fileSystems."/" =
    { device = "/dev/disk/by-uuid/1bf70d51-1db6-4ab7-977a-5f66ec27e705";
      fsType = "ext4";
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/08DD-70E6";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  swapDevices =
    [ { device = "/dev/disk/by-uuid/eed54e9f-2bce-4224-8189-16cbc82793c7"; }
    ];

  fileSystems."/home/${config.username}/Data" = {
    device = "/dev/disk/by-uuid/a990dfba-ad44-4c4f-91e2-149ef6653d09";
    fsType = "ext4";
  };

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.enp1s0f0.useDHCP = lib.mkDefault true;
  # networking.interfaces.wlp2s0.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
