prdynamicmonitors/scripts/work-docked-lid-open.sh\"\n\n[[profiles.work_docked_lid_open.conditions.required_monitors]]\nname = \"eDP-1\"\n[[profiles.work_docked_lid_open.conditions.required_monitors]]\ndescription = \"Dell Inc. DELL P2723DE CC7FH14\"\n[[profiles.work_docked_lid_open.conditions.required_monitors]]\ndescription = \"Dell Inc. DELL P2723DE 4C7FH14\"\n\n[profiles.work_docked_lid_open.conditions.laptop]\nlid_state = \"open\"\n\n# Work docked with lid closed - dual Dell monitors, laptop screen disabled\n[profiles.work_docked_lid_close]\nconfig_file = \"/home/noams/.config/hypr/hyprdynamicmonitors/profiles/work-docked-lid-close.conf\"\npost_apply_exec = \"/home/noams/.config/hypr/hyprdynamicmonitors/scripts/work-docked-lid-close.sh\"\n\n[[profiles.work_docked_lid_close.conditions.required_monitors]]\ndescription = \"Dell Inc. DELL P2723DE CC7FH14\"\n[[profiles.work_docked_lid_close.conditions.required_monitors]]\ndescription = \"Dell Inc. DELL P2723DE 4C7FH14\"\n\n[profiles.work_docked_lid_close.conditions.laptop]\nlid_state = \"closed\"\n\n# Undocked with lid closed - will trigger suspend\n[profiles.undocked_lid_closed]\nconfig_file = \"/home/noams/.config/hypr/hyprdynamicmonitors/profiles/undocked-lid-closed.conf\"\npost_apply_exec = \"/home/noams/.config/hypr/hyprdynamicmonitors/scripts/undocked-lid-closed.sh\"\n\n[[profiles.undocked_lid_closed.conditions.required_monitors]]\nname = \"eDP-1\"\n\n[profiles.undocked_lid_closed.conditions.laptop]\nlid_state = \"closed\"\n\n# Undocked - laptop screen only (fallback profile)\n[profiles.undocked]\nconfig_file = \"/home/noams/.config/hypr/hyprdynamicmonitors/profiles/undocked.conf\"\npost_apply_exec = \"/home/noams/.config/hypr/hyprdynamicmonitors/scripts/undocked.sh\"\n\n[[profiles.undocked.conditions.required_monitors]]\nname = \"eDP-1\"\n"
