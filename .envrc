#!/usr/bin/env bash
watch_file ./flake-modules/development.nix
watch_file flake.lock
use flake . --accept-flake-config

# Determinate's `nix` reaches PATH only via macOS path_helper (login shells), so
# GUI-launched tooling and this devshell can't find it — and the shell ships `nh`
# but not `nix`. Surface the profile bin so `nh` works on darwin.
if [[ $OSTYPE == darwin* ]]; then
  PATH_add /nix/var/nix/profiles/default/bin
fi
