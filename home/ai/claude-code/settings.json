{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(just *)",
      "Bash(curl *)",
      "Bash(shellcheck *)",
      "Bash(prettier *)",
      "Bash(go *)",
      "Bash(golangci-lint *)",
      "Bash(buf *)",
      "Bash(sqlc *)",
      "Bash(atlas migrate *)",
      "Bash(pg_isready *)",
      "Bash(ssh *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(sleep *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(cd *)",
      "Bash(templ *)",
      "Bash(docker *)",
      "Bash(psql *)",
      "Bash(uv *)",
      "Bash(ps *)",
      "Bash(pre-commit *)",
      "Bash(direnv *)",
      "Bash(process-compose *)",
      "Bash(pc *)",
      "Bash(diff *)",
      "Bash(speakeasy *)",
      "Bash(nix *)",
      "Bash(temporal *)",
      "Bash(mv *)",
      "Bash(sed *)",
      "Bash(time *)",
      "Bash(mockery *)",
      "Bash(staticcheck *)",
      "Bash(sqruff *)",
      "Bash(python3 *)",
      "Bash(env)",
      "Bash(op *)",
      "Bash(gtrash *)",
      "Bash(nh *)",
      "Bash(tmux *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(stat *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(date *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(pgrep *)",
      "Bash(journalctl *)",
      "Bash(systemctl *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(tee *)",
      "Bash(xargs *)",
      "Bash(test *)",
      "Bash(type *)",
      "Bash(nom *)",
      "Bash(tokei *)",
      "Bash(home-manager *)",
      "Bash(git add:*)",
      "Bash(tmux list-keys:*)",
      "Bash(npm:*)",
      "Bash(nix-prefetch-url:*)",
      "Read(**/.claude/plugins/**)",
      "mcp__claude_ai_Linear__*",
      "mcp__claude_ai_Notion__*",
      "mcp__plugin_pg_pg-aiguide__*",
      "mcp__plugin_claude-code-home-manager_tavily__*",
      "mcp__plugin_claude-code-home-manager_context7__*",
      "mcp__plugin_claude-code-home-manager_firefox-devtools__*",
      "mcp__plugin_claude-code-home-manager_playwright__*",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "fallbackModel": [
    "claude-sonnet-4-6"
  ],
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "context-efficient-tools@xdg-claude": true,
    "refactoring-agent@xdg-claude": true,
    "commit-commands@claude-code-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "agent-smith@agent-smith": true,
    "resolved@resolved": true
  },
  "extraKnownMarketplaces": {
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    },
    "xdg-claude": {
      "source": {
        "source": "git",
        "url": "https://github.com/xdg/xdg-claude.git"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/obra/superpowers.git"
      }
    },
    "aiguide": {
      "source": {
        "source": "github",
        "repo": "timescale/pg-aiguide"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "jezweb-skills": {
      "source": {
        "source": "github",
        "repo": "jezweb/claude-skills"
      }
    },
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "duckdb-skills": {
      "source": {
        "source": "github",
        "repo": "duckdb/duckdb-skills"
      }
    },
    "agent-smith": {
      "source": {
        "source": "github",
        "repo": "noamsto/agent-smith"
      }
    },
    "resolved": {
      "source": {
        "source": "github",
        "repo": "noamsto/resolved"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "network": {
      "allowedDomains": [
        "*"
      ],
      "allowLocalBinding": true
    }
  },
  "feedbackSurveyRate": 0,
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "teammateMode": "in-process",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "mcpServers": {
    "factify": {
      "type": "http",
      "url": "https://factify-mcp.factify.workers.dev/mcp"
    }
  },
  "additionalDirectories": [
    "~/.claude/plugins/cache"
  ],
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  }
}
