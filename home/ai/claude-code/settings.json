      "Bash(nix *)",
      "Bash(temporal *)",
      "Bash(mv *)",
      "Bash(sed *)",
      "Bash(time *)",
      "Bash(mockery *)",
      "Bash(staticcheck *)",
      "Bash(sqruff *)",
      "Bash(python3 *)",
      "Bash(env)",
      "Bash(op *)",
      "Bash(gtrash *)",
      "Bash(nh *)",
      "Bash(tmux *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(stat *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(date *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(pgrep *)",
      "Bash(journalctl *)",
      "Bash(systemctl *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(tee *)",
