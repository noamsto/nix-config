      "Bash(test *)",
      "Bash(type *)",
      "Bash(nom *)",
      "Bash(tokei *)",
      "Bash(home-manager *)",
      "Bash(git add:*)",
      "Bash(tmux list-keys:*)",
      "Bash(npm:*)",
      "Bash(nix-prefetch-url:*)",
      "Read(/home/noams/.claude/plugins/**)",
      "mcp__claude_ai_Linear__*",
      "mcp__claude_ai_Notion__*",
      "mcp__tavily__*",
      "mcp__context7__*",
      "mcp__plugin_pg_pg-aiguide__*",
      "mcp__plugin_claude-code-home-manager_tavily__*",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "coding-best-practices@xdg-claude": true,
    "superpowers@superpowers-dev": true,
    "context-efficient-tools@xdg-claude": true,
    "refactoring-agent@xdg-claude": true,
    "code-review-agent@xdg-claude": true,
    "commit-commands@claude-code-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "pg@aiguide": true,
    "frontend-design@claude-code-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "cc-skills-golang@samber": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "network": {
      "allowedDomains": ["*"],
      "allowLocalBinding": true
    }
  },
  "mcpServers": {
    "factify": {
      "type": "http",
      "url": "https://factify-mcp.factify.workers.dev/mcp"
    }
  },
  "additionalDirectories": ["~/.claude/plugins/cache"],
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "theme": "dark",
  "tui": "default"
}
