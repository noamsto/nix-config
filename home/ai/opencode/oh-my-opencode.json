{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "default_run_agent": "Sisyphus - Ultraworker",

  "agents": {
    "sisyphus": {
      "model": "opencode/kimi-k2.6",
      "fallback_models": [
        "opencode/kimi-k2.5",
        "opencode/big-pickle",
        "opencode/gemini-3-flash",
        "opencode/gpt-5-nano"
      ]
    },
    "Sisyphus - Ultraworker": {
      "model": "opencode/kimi-k2.6",
      "fallback_models": [
        "opencode/kimi-k2.5",
        "opencode/big-pickle",
        "opencode/gemini-3-flash",
        "opencode/gpt-5-nano"
      ]
    },
    "hephaestus": {
      "model": "opencode/gpt-5.4",
      "fallback_models": [
        "opencode/gpt-5-nano",
        "opencode/big-pickle",
        "opencode/gemini-3-flash"
      ]
    },
    "oracle": {
      "model": "opencode/kimi-k2.5",
      "fallback_models": [
        "opencode/gemini-3-flash",
        "opencode/claude-haiku-4-5",
        "opencode/gpt-5-nano"
      ]
    },
    "prometheus": {
      "model": "opencode/kimi-k2.6",
      "fallback_models": [
        "opencode/gpt-5.4",
        "opencode/big-pickle",
        "opencode/gemini-3-flash"
      ]
    },
    "atlas": {
      "model": "opencode/kimi-k2.5",
      "fallback_models": [
        "opencode/gemini-3-flash",
        "opencode/claude-haiku-4-5",
        "opencode/gpt-5-nano"
      ]
    },
    "metis": {
      "model": "opencode/claude-sonnet-4-6",
      "fallback_models": [
        "opencode/gemini-3-flash",
        "opencode/claude-haiku-4-5",
        "opencode/gpt-5-nano"
      ]
    },
    "explore": {
      "model": "opencode/gpt-5-nano",
      "fallback_models": [
        "opencode/gemini-3-flash",
        "opencode/big-pickle"
      ]
    },
    "librarian": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        "opencode/gemini-3-flash",
        "opencode/kimi-k2.5"
      ]
    }
  },

  "categories": {
    "quick": {
      "model": "opencode/gemini-3-flash",
      "description": "Trivial tasks - single file changes, typo fixes, simple modifications",
      "fallback_models": [
        "opencode/claude-haiku-4-5",
        "opencode/gpt-5-nano"
      ]
    },
    "deep": {
      "model": "opencode/gemini-3.1-pro",
      "description": "Goal-oriented autonomous problem-solving. Thorough research before action. For hairy problems requiring deep understanding.",
      "fallback_models": [
        "opencode/kimi-k2.5",
        "opencode/big-pickle",
        "opencode/gemini-3-flash"
      ]
    },
    "ultrabrain": {
      "model": "opencode/gemini-3.1-pro",
      "description": "Use ONLY for genuinely hard, logic-heavy tasks. Give clear goals only, not step-by-step instructions.",
      "fallback_models": [
        "opencode/big-pickle",
        "opencode/gemini-3-flash"
      ]
    },
    "artistry": {
      "description": "Complex problem-solving with unconventional, creative approaches - beyond standard patterns",
      "fallback_models": [
        "opencode/gemini-3-flash",
        "opencode/big-pickle"
      ]
    },
    "unspecified-high": {
      "model": "opencode/gemini-3.1-pro",
      "description": "Tasks that don't fit other categories, high effort required",
      "fallback_models": [
        "opencode/kimi-k2.5",
        "opencode/big-pickle",
        "opencode/gemini-3-flash"
      ]
    },
    "unspecified-low": {
      "model": "opencode/gemini-3-flash",
      "description": "Tasks that don't fit other categories, low effort required",
      "fallback_models": [
        "opencode/claude-haiku-4-5",
        "opencode/gpt-5-nano"
      ]
    },
    "writing": {
      "model": "opencode/gemini-3-flash",
      "description": "Documentation, prose, technical writing",
      "fallback_models": [
        "opencode/gemini-3.1-pro",
        "opencode/claude-haiku-4-5"
      ]
    },
    "visual-engineering": {
      "model": "opencode/gemini-3.1-pro",
      "description": "Frontend, UI/UX, design, styling, animation. Any task involving UI, UX, CSS, styling, layout, animation, design, or frontend components MUST go here.",
      "fallback_models": [
        "opencode/claude-sonnet-4-6",
        "opencode/gemini-3-flash",
        "opencode/big-pickle"
      ]
    }
  },

  "sisyphus_agent": {
    "disabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "tdd": true
  },

  "tmux": {
    "enabled": false,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40,
    "isolation": "inline"
  },

  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 100,
    "default_strategy": "continue"
  },

  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 429, 503, 529],
    "notify_on_fallback": true
  },

  "background_task": {
    "providerConcurrency": {
      "anthropic": 2,
      "openai": 3,
      "google": 5,
      "opencode": 10
    }
  },

  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true,
    "refresh_timeout_ms": 5000
  },

  "experimental": {
    "auto_resume": true
  }
}
