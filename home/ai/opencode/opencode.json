        "baseURL": "http://127.0.0.1:13305/v1"
      },
      "models": {
        "Gemma-4-26B-A4B-it-GGUF": {"name": "Gemma-4-26B-A4B-it-GGUF (local)", "contextWindow": 40960},
        "Phi-4-mini-instruct-GGUF": {"name": "Phi-4-mini-instruct-GGUF (local)", "contextWindow": 40960},
        "Qwen3.5-9B-GGUF": {"name": "Qwen3.5-9B-GGUF (local)", "contextWindow": 40960},
        "deepseek-r1-0528-8b-FLM": {"name": "deepseek-r1-0528-8b-FLM (local)", "contextWindow": 40960},
        "deepseek-r1-8b-FLM": {"name": "deepseek-r1-8b-FLM (local)", "contextWindow": 40960},
        "gpt-oss-20b-FLM": {"name": "gpt-oss-20b-FLM (local)", "contextWindow": 40960},
        "qwen3.5-9b-FLM": {"name": "qwen3.5-9b-FLM (local)", "contextWindow": 40960},
        "qwen3vl-it-4b-FLM": {"name": "qwen3vl-it-4b-FLM (local)", "contextWindow": 40960}
      }
    }
  }
