{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "/home/noams/.config/opencode/instructions/conventional-commits.md",
    "/home/noams/.config/opencode/instructions/verify-before-done.md"
  ],
  "plugin": [
    "oh-my-openagent"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["context7-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp-wrapper"],
      "enabled": true
    }
  },
  "provider": {
    "Lemonade": {
      "name": "Lemonade Server (local)",
