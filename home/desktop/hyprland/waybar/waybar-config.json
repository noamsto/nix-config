[
  {
    "height": 42,
    "layer": "top",
    "exclusive": true,
    "passthrough": false,
    "modules-left": [
      "hyprland/workspaces",
      "custom/audio_idle_inhibitor",
      "custom/screen_recording",
      "tray"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "network",
      "group/hardware",
      "group/power",
      "group/backlight",
      "group/audio",
      "custom/keyboard-layout",
      "custom/swaync"
    ],
    "custom/separator#dot": {
      "format": "",
      "interval": "once",
      "tooltip": false
    },
    "custom/separator#dot-line": {
      "format": "",
      "interval": "once",
      "tooltip": false
    },
    "custom/separator#line": {
      "format": "|",
      "interval": "once",
      "tooltip": false
    },
    "custom/separator#blank": {
      "format": "",
      "interval": "once",
      "tooltip": false
    },
    "custom/separator#blank_2": {
      "format": "  ",
      "interval": "once",
      "tooltip": false
    },
    "custom/separator#blank_3": {
      "format": "   ",
      "interval": "once",
      "tooltip": false
    },
    "group/hardware": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": true
      },
      "modules": [
        "cpu",
        "memory",
        "disk"
      ]
    },
    "group/audio": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": false
      },
      "modules": [
        "pulseaudio",
        "pulseaudio#microphone"
      ]
    },
    "group/power": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": false
      },
      "modules": [
        "battery",
        "custom/timed-inhibitor",
        "power-profiles-daemon"
      ]
    },
    "group/backlight": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": false
      },
      "modules": [
        "backlight",
        "custom/hyprsunset",
        "backlight/slider"
      ]
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "all-outputs": false,
      "sort-by-number": true,
      "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
      },
      "on-scroll-down": "hyprctl dispatch workspace m+1",
      "on-scroll-up": "hyprctl dispatch workspace m-1"
    },
    "tray": {
      "spacing": 10
    },
    "clock": {
      "tooltip": true,
      "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "   {:%H:%M}",
      "on-click": "date --iso-8601=seconds | wl-copy && notify-send 'Clock' 'ISO time copied to clipboard' -i appointment-soon",
      "calendar": {
        "mode": "month",
        "on-scroll": 1,
        "actions": {
          "on-scroll-up": "shift_up",
          "on-scroll-down": "shift_down"
        },
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "days": "<span color='#ecc6d9'>{}</span>",
          "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "today": "<span color='#000000' background='#00ff88'><b><u>{}</u></b></span>"
        }
      }
    },
    "cpu": {
      "format": "{usage}% ",
      "interval": 1,
      "format-alt-click": "click",
      "on-click-right": "resources"
    },
    "memory": {
      "interval": 10,
      "format": "{used:0.1f}G 󰾆",
      "format-alt": "{percentage}% 󰾆",
      "format-alt-click": "click",
      "tooltip": true,
      "tooltip-format": "{used:0.1f}GB/{total:0.1f}G",
      "on-click-right": "foot btop"
    },
    "disk": {
      "interval": 30,
      "path": "/",
      "format": "{percentage_used}% 󰋊",
      "format-alt-click": "click",
      "format-alt": "{free} free 󰋊",
      "tooltip": true,
      "tooltip-format": "{used} used out of {total} on {path} ({percentage_used}%)"
    },
    "pulseaudio": {
      "format": "{icon}  {volume}%",
      "format-bluetooth": "{icon}  {volume}%",
      "format-muted": "󰝟  {volume}%",
      "format-icons": {
        "headphone": "󰋋",
        "hands-free": "󰋎",
        "headset": "󰋎",
        "phone": "",
        "portable": "",
        "car": "",
        "default": [
          "󰕿",
          "󰖀",
          "󰕾",
          "󰕾"
        ]
      },
      "ignored-sinks": [
        "Easy Effects Sink"
      ],
      "scroll-step": 5.0,
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "pavucontrol -t 3",
      "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
      "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-",
      "tooltip-format": "{icon} {desc} | {volume}%",
      "smooth-scrolling-threshold": 1
    },
    "pulseaudio#microphone": {
      "format": "{format_source}",
      "format-source": " {volume}%",
      "format-source-muted": "󰍭",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
      "on-click-right": "pavucontrol -t 4",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
      "tooltip-format": "{source_desc} | {source_volume}%",
      "scroll-step": 5
    },
    "battery": {
      "full-at": 100,
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": "{icon} {capacity}%",
      "format-plugged": " {icon} {capacity}%",
      "format-full": "{icon} Full",
      "format-time": "{H}h {M}min",
      "format-icons": {
        "charging": [
          "󰢜",
          "󰂆",
          "󰂇",
          "󰂈",
          "󰂉",
          "󰂊",
          "󰂋",
          "󰂅"
        ],
        "default": [
          "󰁺",
          "󰁺",
          "󰁻",
          "󰁼",
          "󰁽",
          "󰁾",
          "󰁿",
          "󰂀",
          "󰂁",
          "󰂂",
          "󰁹"
        ]
      },
      "tooltip": true
    },
    "network": {
      "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}",
      "tooltip-format-wifi": "{ifname} ({signalStrength}%) | {ipaddr}/{cidr} | {gwaddr}",
      "interval": 2,
      "on-click-right": "nm-connection-editor",
      "format": "{icon}",
      "format-alt-click": "click",
      "format-alt": "{icon}  {bandwidthDownBytes}  {bandwidthUpBytes}",
      "format-disconnected": "󰤭  Offline",
      "format-wifi": "󰤨  {essid}",
      "format-ethernet": "󰈀  {ifname}",
      "max-length": 25,
      "format-icons": {
        "wifi": [
          "󰤯",
          "󰤟",
          "󰤢",
          "󰤥",
          "󰤨"
        ],
        "ethernet": "󰈀",
        "disconnected": "󰤭"
      }
    },
    "custom/keyboard-layout": {
      "format": "{}",
      "exec": "keyboard-layout",
      "return-type": "json",
      "restart-interval": 0,
      "on-click": "hyprctl switchxkblayout xremap next",
      "tooltip": true
    },
    "custom/timed-inhibitor": {
      "format": "{}",
      "exec": "timed-inhibitor",
      "on-click": "timed-inhibitor toggle",
      "return-type": "json",
      "interval": 1,
      "escape": true
    },
    "custom/audio_idle_inhibitor": {
      "format": "{icon}",
      "exec": "if wpctl status | grep -E 'RUNNING|Audio/Sink.*vol:' | grep -q 'RUNNING'; then echo '{\"text\": \"󰐎 \", \"tooltip\": \"Audio playing - idle inhibited\", \"class\": \"active\"}'; else echo '{\"text\": \"󰐏 \", \"tooltip\": \"No audio - idle not inhibited\", \"class\": \"inactive\"}'; fi",
      "return-type": "json",
      "interval": 2,
      "format-icons": {
        "output": "󰐎",
        "input": "󰐏 ",
        "output-input": "󰐎 󰐏 ",
        "none": "󰐏 "
      }
    },
    "custom/swaync": {
      "tooltip": true,
      "format": "{icon}",
      "format-icons": {
        "notification": "󰂚 <span foreground='red'><sup></sup></span>",
        "none": "󰂚",
        "dnd-notification": "󰂛 <span foreground='red'><sup></sup></span>",
        "dnd-none": "󰂛",
        "inhibited-notification": "󰂚 <span foreground='red'><sup></sup></span>",
        "inhibited-none": "󰂚",
        "dnd-inhibited-notification": "󰂛 <span foreground='red'><sup></sup></span>",
        "dnd-inhibited-none": "󰂛"
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true
    },
    "custom/hyprsunset": {
      "format": "{}",
      "return-type": "json",
      "exec": "state_file=\"$HOME/.cache/hyprsunset_active\"; if [ -f \"$state_file\" ]; then echo '{\"text\": \"󰌵\", \"tooltip\": \"Blue light filter: ON (4000K)\", \"class\": \"on\"}'; else echo '{\"text\": \"󰌶\", \"tooltip\": \"Blue light filter: OFF\", \"class\": \"off\"}'; fi",
      "interval": 2,
      "on-click": "state_file=\"$HOME/.cache/hyprsunset_active\"; if [ -f \"$state_file\" ]; then hyprctl hyprsunset identity; rm -f \"$state_file\"; notify-send \"Blue Light Filter\" \"Disabled\" -i display-brightness 2>/dev/null || true; else hyprctl hyprsunset temperature 4000; touch \"$state_file\"; notify-send \"Blue Light Filter\" \"Enabled (4000K)\" -i display-brightness 2>/dev/null || true; fi"
    },
    "custom/screen_recording": {
      "format": "{}",
      "return-type": "json",
      "exec": "record_type_file=\"$HOME/.cache/current_record_type\"; if pgrep -x \"wl-screenrec\" >/dev/null; then if [ -f \"$record_type_file\" ]; then record_type=$(cat \"$record_type_file\"); case \"$record_type\" in \"gif\") echo '{\"text\": \"󰹑\", \"tooltip\": \"Recording GIF - Press Alt+Shift+R to stop\", \"class\": \"recording-gif\"}' ;; \"mp4\") echo '{\"text\": \"󰐌\", \"tooltip\": \"Recording MP4 - Press Super+Shift+R to stop\", \"class\": \"recording-mp4\"}' ;; *) echo '{\"text\": \"󰻃\", \"tooltip\": \"Screen recording active\", \"class\": \"recording\"}' ;; esac; else echo '{\"text\": \"󰻃\", \"tooltip\": \"Screen recording active\", \"class\": \"recording\"}'; fi; else echo '{\"text\": \"\", \"tooltip\": \"\", \"class\": \"idle\"}'; fi",
      "interval": 1,
      "on-click": "record_type_file=\"$HOME/.cache/current_record_type\"; if pgrep -x \"wl-screenrec\" >/dev/null && [ -f \"$record_type_file\" ]; then record_type=$(cat \"$record_type_file\"); exec record-screen \"$record_type\"; else pkill -INT -x \"wl-screenrec\" 2>/dev/null || true; fi"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}\n\nAutomatic switching on AC connect/disconnect",
      "tooltip": true,
      "format-icons": {
        "performance": "",
        "balanced": " ",
        "power-saver": ""
      }
    },
    "backlight": {
      "format": "{icon}",
      "format-icons": [
        "󰃞",
        "󰃟",
        "󰃠"
      ],
      "tooltip": true,
      "tooltip-format": "Brightness: {percent}%",
      "on-scroll-up": "brightness-control --inc 5",
      "on-scroll-down": "brightness-control --dec 5",
      "interval": 1
    },
    "backlight/slider": {
      "min": 5,
      "max": 100,
      "orientation": "horizontal",
      "on-click": "brightness-control --set {value}",
      "on-scroll-up": "brightness-control --inc 5",
      "on-scroll-down": "brightness-control --dec 5"
    }
  }
]
