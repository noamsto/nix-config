# Undocked - laptop only with dynamic lid handling
# Template handles both lid open (normal use) and lid closed (triggers suspend via script)
# Uses .MonitorsByTag for gen5/gen6 compatibility

{{- $laptop := index .MonitorsByTag "laptop" -}}

# Laptop screen configuration - scale @laptopScale@ (gen5: 2.0, gen6: 1.25)
monitor={{$laptop.Name}},preferred,0x0,@laptopScale@

# Named workspaces on laptop
workspace=1,monitor:{{$laptop.Name}},default:true,name:dev
workspace=2,monitor:{{$laptop.Name}},name:web
workspace=3,monitor:{{$laptop.Name}}
workspace=4,monitor:{{$laptop.Name}}
workspace=5,monitor:{{$laptop.Name}},name:comms
workspace=6,monitor:{{$laptop.Name}}
workspace=7,monitor:{{$laptop.Name}}
workspace=8,monitor:{{$laptop.Name}}
workspace=9,monitor:{{$laptop.Name}},name:media
