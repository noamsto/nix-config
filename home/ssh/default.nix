{
  lib,
  osConfig,
  pkgs,
  ...
}: let
  agent = osConfig.nix-config.ssh.onePasswordAgent;
  githubKey = osConfig.nix-config.ssh.githubKey;
in {
  home.file = {
    # force = true: HM's checkLinkTargets sees the regular file left by
    # copySshConfig (below) and would refuse to overwrite it. Forcing lets
    # linkGeneration replace it with a symlink, then copySshConfig converts
    # it back to a 600-permission copy.
    ".ssh/config".force = true;
    ".ssh/1password.pub" = lib.mkIf agent.enable {text = agent.publicKey + "\n";};
  };

  programs.ssh = {
    enable = true;
    enableDefaultConfig = false;

    # all my ssh private key are generated by `ssh-keygen -t ed25519 -C "name"`
    # the config's format:
    #   Host —  given the pattern used to match against the host name given on the command line.
    #   HostName — specify nickname or abbreviation for host
    #   IdentityFile — the location of your SSH key authentication file for the account.
    # format in details:
    #   https://www.ssh.com/academy/ssh/config
    settings = {
      "*" =
        {
          SendEnv = ["LANG" "LC_*"];
          Include = "/etc/ssh/host_ssh.conf";
          ForwardAgent = false;
          AddKeysToAgent = "no";
          Compression = false;
          ServerAliveInterval = 0;
          ServerAliveCountMax = 3;
          HashKnownHosts = false;
          UserKnownHostsFile = "~/.ssh/known_hosts";
          ControlMaster = "no";
          ControlPath = "~/.ssh/master-%r@%n:%p";
          ControlPersist = "no";
        }
        // lib.optionalAttrs agent.enable {
          # Home Manager renders values with a bare toString, so the darwin path
          # (which contains a space) carries its own double quotes.
          IdentityAgent =
            if pkgs.stdenv.hostPlatform.isDarwin
            then ''"~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"''
            else "~/.1password/agent.sock";
        };

      "github.com" =
        {
          HostName = "ssh.github.com";
          Port = 443;
          # 1Password selects the key by its public half under IdentitiesOnly.
          IdentityFile =
            if githubKey != null
            then githubKey
            else if agent.enable
            then "~/.ssh/1password.pub"
            else "~/.ssh/id_ed25519";
          IdentitiesOnly = true;
          # One key approval per burst of git operations instead of per operation.
          # ServerAliveInterval drops a master left dead by suspend or a network change.
          ControlMaster = "auto";
          ControlPersist = "10m";
          ServerAliveInterval = 30;
        }
        // lib.optionalAttrs (githubKey != null) {
          # ssh reads the key file itself and never contacts the 1Password agent.
          IdentityAgent = "none";
        };
    };
  };

  xdg.configFile."1Password/ssh/agent.toml" = lib.mkIf (agent.enable && agent.keys != []) {
    # builtins.toJSON yields a quoted string, valid as a TOML basic string.
    text =
      lib.concatMapStringsSep "\n" (
        key:
          "[[ssh-keys]]\n"
          + lib.concatMapStrings (field: lib.optionalString (key.${field} != null) "${field} = ${builtins.toJSON key.${field}}\n") ["item" "vault" "account"]
      )
      agent.keys;
  };

  # Replace HM's symlink with a 600-permission copy.
  # OpenSSH rejects the nix-store symlink (lrwxrwxrwx / root-owned target).
  # No native HM option exists yet (nix-community/home-manager#322).
  #
  # On first run: linkGeneration creates symlink → we resolve and copy it.
  # On subsequent runs: linkGeneration skips (sees existing regular file with
  # same content) → we still need to ensure 600 ownership. We find the
  # intended source from the current generation's home-files tree.
  home.activation.copySshConfig = lib.hm.dag.entryAfter ["writeBoundary"] ''
    sshCfg="$HOME/.ssh/config"
    if [ -L "$sshCfg" ]; then
      src="$(readlink -f "$sshCfg")"
      run rm -f "$sshCfg"
      run install -m 600 "$src" "$sshCfg"
    elif [ -f "$sshCfg" ]; then
      src="$(readlink -f "$newGenPath/home-files/.ssh/config")"
      if [ -f "$src" ] && ! cmp -s "$sshCfg" "$src"; then
        run rm -f "$sshCfg"
        run install -m 600 "$src" "$sshCfg"
      else
        run chmod 600 "$sshCfg"
      fi
    fi
  '';
}
