direction: right
cron: "schedule / workflow_dispatch\n(no source)" {shape: oval}
upstream: "noamsto/tmux-og\nrepository_dispatch upstream-updated" {shape: oval; style.stroke: green}
select: "NEW prepare: Select\nupdate_bot.py select -> botcore.select_run\n(.github/upstreams.json allowlist, 40-hex rev)" {style.stroke: green}
prepare: "prepare\nupdate_bot.py prepare [--only input]"
full: "combined / split-nixpkgs / split-inputs\n(mode == full, unchanged)"
narrow: "NEW narrow job\nupdate-attempt.yml attempt: narrow" {style.stroke: green}
finalize: "finalize --mode\nbotcore.finalize | NEW finalize_narrow"
land: "land: PR + squash merge\nNEW Landed sha step"
recipients: "NEW recipients job\n.github/consumers.json + CASCADE_CONSUMERS secret\noutputs indexes only" {style.stroke: green}
notify: "NEW notify job (matrix: index)\nmask entry -> create-github-app-token -> POST /dispatches" {style.stroke: green}
hosts: "private host flake" {shape: oval}
skip: "skip: ::notice::, run ends green" {shape: oval}
cron -> select
upstream -> select
select -> skip: "unknown source / bad rev"
select -> prepare
prepare -> full: "full"
prepare -> narrow: "narrow"
full -> finalize
narrow -> finalize
finalize -> land -> recipients -> notify -> hosts: "upstream-updated {source, rev}"
