direction: down

hook: "secret-read-guard.sh\n(4s hook budget)" {shape: rectangle}
charge: "hash_charge (NEW)\ncount '#' only after the byte check passes,\ncharge comment_weight=8 bytes each" {
  style.stroke: "#27ae60"
  style.stroke-width: 3
}
budget: "over_scan_budget\n(scan_budget=16384)" {shape: diamond}
deny: "deny: too long to verify\n(decides in ~0.2s)" {shape: rectangle}
scanners: "scanners, per pass over the string s" {
  mq: "mask_quotes\nresets CC_POS/CC_OPEN"
  ss: "scan_substs\nresets; find_paren_end shares it"
  dq: "dequote\nresets"
}
ca: "comment_at(i) (CHANGED)\nreads caller's s, folds only text since last call,\nfinds comment end by window" {
  style.stroke: "#27ae60"
  style.stroke-width: 3
}

hook -> budget: "bytes"
budget -> charge: "within budget"
charge -> budget: "bytes + '#' charge"
budget -> deny: "over budget (dense '#')"
budget -> scanners: "passes"
scanners.mq -> ca
scanners.ss -> ca
scanners.dq -> ca
