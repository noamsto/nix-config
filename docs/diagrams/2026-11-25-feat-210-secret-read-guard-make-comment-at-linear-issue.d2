direction: down

hook: "secret-read-guard.sh\n(4s hook budget, overrun abstains = fail open)" {shape: rectangle}
budget: "over_scan_budget\n(scan_budget=16384 bytes)" {shape: diamond}
scanners: "scanners, per pass over the string s" {
  mq: "mask_quotes"
  ss: "scan_substs\n(+ find_paren_end)"
  dq: "dequote"
}
ca: "comment_at(s, i)\nper '#': pass s as argument,\nslice s[0:i], strip tail copy" {
  style.stroke: "#c0392b"
  style.stroke-width: 3
}
cost: "cost per '#' grows with len(s)\n'#\\n' x6000 (12KB, under budget): 4.5s" {
  style.stroke: "#c0392b"
  style.font-color: "#c0392b"
}

hook -> budget: "bytes only"
budget -> scanners: "12KB passes"
scanners.mq -> ca
scanners.ss -> ca
scanners.dq -> ca
ca -> cost
cost -> hook: "overruns 4s, guard abstains" {style.stroke: "#c0392b"}
